---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Preloader from '../components/Preloader.astro';
import Contacto from '../components/Contacto.astro';
import { foto } from '../lib/fotos';
import sitio from '../data/sitio.json';

interface Props {
  titulo: string;
  descripcion: string;
  ogFoto?: string;
  headerTransparente?: boolean;
  modelo?: string;          // nombre del modelo (WhatsApp prearmado, campos ocultos)
  jsonLd?: Record<string, unknown>[];
}
const { titulo, descripcion, ogFoto = 'proyecto/aerea-render-proyecto.jpg', headerTransparente = false, modelo, jsonLd = [] } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: foto(ogFoto), width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 78 });
const ogUrl = new URL(og.src, Astro.site).href;
const gaId = import.meta.env.PUBLIC_GA_ID;

const organizacion = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: sitio.desarrollador,
  url: Astro.site?.href,
  email: sitio.contacto.correos[0],
  telephone: sitio.contacto.telefono.tel,
  address: { '@type': 'PostalAddress', streetAddress: 'Vía España, PH Domino, Planta Baja Local #3', addressLocality: 'Ciudad de Panamá', addressCountry: 'PA' },
  sameAs: sitio.redes.map((r) => r.url),
};
const proyecto = {
  '@context': 'https://schema.org',
  '@type': 'Residence',
  name: sitio.nombre,
  description: 'Casas de 2 y 3 recámaras, de una planta y dúplex, en Arraiján, Panamá Oeste. Desde $88,997.',
  url: Astro.site?.href,
  image: ogUrl,
  address: { '@type': 'PostalAddress', addressLocality: 'Arraiján', addressRegion: 'Panamá Oeste', addressCountry: 'PA' },
  hasMap: sitio.mapa.comoLlegar,
  amenityFeature: ['Parque infantil', 'Canchas deportivas', 'Minigolf', 'Pumptrack', 'Gazebo', 'Áreas verdes', 'Zona de ejercicios', 'Área de yoga', 'Área para mascotas']
    .map((name) => ({ '@type': 'LocationFeatureSpecification', name, value: true })),
};
const schemas = [organizacion, proyecto, ...jsonLd];
---
<!doctype html>
<html lang="es-PA">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{titulo}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#0F3B2C" />
  <link rel="icon" type="image/png" href="/favicon.png" />

  <link rel="preload" href="/fonts/playfair-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
  <!-- La cursiva está en la mitad del título del hero (elemento LCP) -->
  <link rel="preload" href="/fonts/playfair-italic-latin.woff2" as="font" type="font/woff2" crossorigin />

  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_PA" />
  <meta property="og:site_name" content={sitio.nombre} />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />

  <!-- Estado inicial: activa animaciones solo si JS corre y la intro solo en la primera visita -->
  <script is:inline>
    (function () {
      var d = document.documentElement;
      d.classList.add('js');
      try {
        // Intro solo en desktop: en celular se prioriza que el contenido aparezca de inmediato.
        if (!sessionStorage.getItem('pda-intro') && matchMedia('(min-width: 1024px)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          d.classList.add('intro');
          sessionStorage.setItem('pda-intro', '1');
        }
      } catch (e) {}
      setTimeout(function () { if (!window.__pda) { d.classList.remove('js', 'intro'); } }, 4000);
    })();
  </script>

  {gaId && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    </>
  )}

  {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body data-modelo={modelo ?? ''}>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <Preloader />
  <Header transparente={headerTransparente} />
  <main id="contenido">
    <slot />
  </main>
  <Footer />
  <Contacto modelo={modelo} />
  <script>
    import '../scripts/main';
  </script>
</body>
</html>
