---
import Foto from '../Foto.astro';
import Icon from '../Icon.astro';
import modelos from '../../data/modelos.json';
import sitio from '../../data/sitio.json';
---
<section id="inicio" class="hero on-dark" aria-label="Inicio" data-hero>
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__capa hero__capa--base">
      <Foto src="proyecto/aerea-render-proyecto.jpg" alt="" prioridad sizes="100vw" class="cubre hero__kb" />
    </div>
    {modelos.map((m, i) => (
      <div class="hero__capa hero__capa--modelo" data-hero-capa={i}>
        <Foto src={m.fotoPrincipal} alt="" sizes="100vw" widths={[1080, 1440, 1920]} class="cubre" />
      </div>
    ))}
    <span class="hero__velo"></span>
  </div>
  <p class="sr-only">Vista aérea del proyecto Praderas de Arraiján, rodeado de árboles y áreas verdes.</p>

  <div class="hero__contenido wrap">
    <p class="hero__lugar hero-in" style="--d:0s">Arraiján · Panamá Oeste</p>
    <!-- Entrada por líneas con máscara en CSS puro: no espera al JS (es el LCP) -->
    <h1 class="hero__titulo display">
      <span class="linea"><span style="--d:.05s">Tu casa, tu espacio,</span></span>
      <span class="linea"><em style="--d:.15s">tu nuevo estilo de vida.</em></span>
    </h1>
    <div class="hero__datos hero-in" style="--d:.45s">
      <p class="hero__sub">Casas de 2 y 3 recámaras, de una planta y dúplex, rodeadas de áreas verdes a 34 km de la ciudad.</p>
      <p class="hero__precio"><span>Desde</span><strong>{sitio.precioDesde}</strong></p>
    </div>
    <div class="hero__ctas hero-in" style="--d:.55s">
      <a class="btn btn--lg btn--cta" href="#agenda" data-magnetic data-track="agendar"><Icon name="agenda" size={20} />Agenda tu visita<span class="btn-fill"></span></a>
      <a class="btn btn--lg btn--claro" href="#cuota" data-magnetic>Calcula tu cuota<span class="btn-fill"></span></a>
    </div>
  </div>

  <div class="hero__pie wrap hero-in" style="--d:.7s">
    <ul role="list" class="hero__thumbs" aria-label="Modelos" data-hero-thumbs>
      {modelos.map((m, i) => (
        <li>
          <a class="hero__thumb" href={`/modelos/${m.slug}`} data-hero-thumb={i}>
            <span class="hero__thumb-foto"><Foto src={m.fotoPrincipal} alt="" widths={[160]} sizes="72px" class="cubre" /></span>
            <span class="hero__thumb-txt">
              <span class="hero__thumb-tipo">{m.tipoCorto}</span>
              <span class="hero__thumb-nombre">{m.nombre}</span>
              <span class="hero__thumb-ver">Ver modelo <Icon name="flecha" size={14} class="arrow-move" /></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <a class="hero__explora" href="#manifiesto">Explora<span class="hero__linea" aria-hidden="true"><span></span></span></a>
  </div>
</section>

<style>
  .hero {
    position: relative; min-height: 100svh; display: flex; flex-direction: column;
    background: var(--verde-950); color: var(--hueso); overflow: hidden; isolation: isolate;
  }
  .hero__bg, .hero__capa { position: absolute; inset: 0; z-index: -1; overflow: hidden; }
  .hero__kb { animation: kenburns 12s var(--ease) both; }
  :global(html.intro) .hero__kb { animation-delay: .9s; }
  @keyframes kenburns { from { transform: scale(1.08); } to { transform: scale(1); } }
  .hero__capa--modelo { clip-path: inset(100% 0 0 0); transition: clip-path 1.1s var(--ease); }
  .hero__capa--modelo.is-activa { clip-path: inset(0); }
  .hero__velo {
    position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgb(11 47 35 / .7) 0%, rgb(11 47 35 / .4) 42%, rgb(11 47 35 / 0) 72%),
      linear-gradient(180deg, rgb(11 47 35 / .66) 0%, rgb(11 47 35 / .2) 34%, rgb(11 47 35 / .38) 60%, rgb(11 47 35 / .9) 100%);
  }

  .hero__contenido { flex: 1; display: flex; flex-direction: column; justify-content: center; padding-top: 170px; padding-bottom: 40px; }
  .hero__lugar { margin-bottom: 28px; font-size: .8125rem; letter-spacing: .34em; font-weight: 600; text-transform: uppercase; }
  .hero__titulo { max-width: 65rem; font-size: var(--fs-hero); line-height: .98; letter-spacing: -.02em; }
  .hero__datos { margin-top: 36px; display: flex; flex-wrap: wrap; align-items: center; gap: 32px; }
  .hero__sub { max-width: 27.5rem; font-size: 1.125rem; line-height: 1.55; color: rgb(250 247 241 / .88); }
  .hero__precio { display: flex; flex-direction: column; gap: 2px; padding-left: 32px; border-left: 1px solid rgb(250 247 241 / .3); }
  .hero__precio span { font-size: .75rem; letter-spacing: .24em; font-weight: 600; text-transform: uppercase; }
  .hero__precio strong { font-family: var(--font-display); font-weight: 400; font-size: 2.75rem; line-height: 1; }
  .hero__ctas { margin-top: 40px; display: flex; flex-wrap: wrap; gap: 12px; }

  .hero__pie { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; padding-bottom: 40px; }
  .hero__thumbs { display: flex; gap: 12px; }
  .hero__thumb {
    display: flex; align-items: center; gap: 14px; width: 250px; padding: 8px 18px 8px 8px;
    border-radius: 20px; background: rgb(250 247 241 / .86); color: var(--tinta); text-decoration: none;
    transition: background .4s var(--ease), transform .5s var(--ease);
  }
  .hero__thumb:hover, .hero__thumb:focus-visible, .hero__thumb.is-activa { background: var(--hueso); transform: translateY(-4px); }
  .hero__thumb-foto { position: relative; flex: none; width: 72px; height: 72px; border-radius: 14px; overflow: hidden; }
  .hero__thumb-txt { display: flex; flex-direction: column; gap: 3px; }
  .hero__thumb-tipo { font-size: .625rem; letter-spacing: .2em; font-weight: 700; text-transform: uppercase; color: var(--gris-texto); }
  .hero__thumb-nombre { font-family: var(--font-display); font-size: 1.375rem; line-height: 1.05; }
  .hero__thumb-ver { display: inline-flex; align-items: center; gap: 4px; font-size: .8125rem; font-weight: 700; color: var(--pda-tierra); }

  .hero__explora { display: flex; align-items: center; gap: 14px; color: var(--hueso); text-decoration: none; font-size: .75rem; letter-spacing: .3em; font-weight: 600; text-transform: uppercase; }
  .hero__linea { position: relative; width: 1px; height: 64px; background: rgb(250 247 241 / .25); overflow: hidden; }
  /* Solo transform: corre en el compositor, sin recalcular estilos en cada cuadro */
  .hero__linea span { position: absolute; inset: 0; background: var(--hueso); transform: translateY(-100%); animation: scroll-ind 2.4s var(--ease) infinite; }
  @keyframes scroll-ind {
    0% { transform: translateY(-100%); }
    50% { transform: translateY(0); }
    100% { transform: translateY(100%); }
  }

  @media (max-width: 1023px) {
    .hero__capa--modelo { display: none; }
    .hero__contenido { padding-top: 120px; justify-content: flex-end; padding-bottom: 24px; }
    .hero__titulo { font-size: clamp(2.5rem, 11.5vw, 3.5rem); }
    .hero__lugar { margin-bottom: 18px; font-size: .6875rem; }
    .hero__datos { gap: 20px; margin-top: 24px; }
    .hero__sub { font-size: 1rem; }
    .hero__ctas { margin-top: 24px; }
    /* En celular "Agenda tu visita" ya vive en la barra fija inferior */
    .hero__ctas .btn--cta { display: none; }
    .hero__ctas .btn { --btn-h: 52px; }
    .hero__precio { padding-left: 20px; }
    .hero__precio strong { font-size: 2.25rem; }
    .hero__pie { padding-bottom: 104px; }
    .hero__thumbs { overflow-x: auto; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); scrollbar-width: none; }
    .hero__thumb { width: 210px; padding-right: 12px; }
    .hero__thumb-foto { width: 56px; height: 56px; }
    .hero__explora { display: none; }
  }
</style>
