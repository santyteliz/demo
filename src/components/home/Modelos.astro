---
import Foto from '../Foto.astro';
import Icon from '../Icon.astro';
import Confirmar from '../Confirmar.astro';
import modelos from '../../data/modelos.json';

const datos = (m: (typeof modelos)[number]) => [
  { icono: 'recamaras', label: 'Recámaras', ...m.recamaras },
  { icono: 'banos', label: 'Baños', ...m.banos },
  { icono: 'm2', label: 'Construcción', valor: m.m2.valor === '—' ? '— m²' : `${m.m2.valor} m²`, confirmar: m.m2.confirmar },
  { icono: 'precio', label: 'Precio desde', valor: m.precio.texto, confirmar: m.precio.confirmar },
] as const;
---
<section id="modelos" class="sec sec--arena mod" aria-labelledby="mod-t" data-modelos>
  <div class="wrap">
    <div class="sec-head">
      <h2 id="mod-t" class="display h2" data-split>Tres casas,<br /><em>una para tu familia.</em></h2>
      <div class="mod__tabs" role="tablist" aria-label="Elegir modelo">
        {modelos.map((m, i) => (
          <button type="button" role="tab" class="mod__tab" id={`mod-tab-${i}`} aria-controls={`mod-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-mod-tab={i}>
            0{i + 1} · {m.nombre}
          </button>
        ))}
      </div>
    </div>

    <div class="mod__stage" data-mod-stage>
      {modelos.map((m, i) => (
        <div class:list={['mod__panel', { 'is-activo': i === 0 }]} id={`mod-panel-${i}`} role="tabpanel" aria-labelledby={`mod-tab-${i}`} data-mod-panel={i}>
          <div class="mod__texto">
            <div>
              <p class="mod__num">0{i + 1}<span>/ 03</span><span class="mod__tipo">{m.tipo}</span></p>
              <h3 class="mod__nombre">{m.nombreA}{m.nombreB && <em>{m.nombreB}</em>}</h3>
              <p class="mod__desc">{m.descripcion}</p>
            </div>
            <dl class="mod__datos">
              {datos(m).map((d) => (
                <div>
                  <dt><span class="ico-box"><Icon name={d.icono} /></span>{d.label}</dt>
                  <dd>{d.valor} {d.confirmar && <Confirmar />}</dd>
                </div>
              ))}
            </dl>
            <div class="mod__ctas">
              <a class="btn btn--verde" href={`/modelos/${m.slug}`} data-magnetic>Ver modelo <Icon name="flecha" size={18} class="arrow-move" /><span class="btn-fill"></span></a>
              <a class="btn btn--borde" href="#cuota" data-calc-modelo={m.slug} data-magnetic>Calcular cuota<span class="btn-fill"></span></a>
            </div>
          </div>
          <div class="mod__fotos">
            <a class="mod__foto-main hover-zoom" href={`/modelos/${m.slug}`} tabindex="-1" style={`view-transition-name: foto-${m.slug}`}>
              <Foto src={m.fotoPrincipal} alt={m.fotoPrincipalAlt} sizes="(min-width: 1024px) 50vw, 90vw" class="cubre" />
            </a>
            <div class="mod__foto-sec">
              <Foto src={m.fotoSecundaria} alt={m.fotoSecundariaAlt} widths={[480, 768]} sizes="(min-width: 1024px) 22vw, 40vw" class="cubre" />
            </div>
            <p class="mod__tag">{m.tagHero}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="mod__progreso" aria-hidden="true">
      {modelos.map((_, i) => <span><span data-mod-barra={i}></span></span>)}
    </div>
  </div>
</section>

<style>
  .mod__tabs { display: flex; gap: 6px; padding: 6px; background: var(--hueso); border-radius: var(--r-pill); flex-wrap: wrap; }
  .mod__tab {
    min-height: 44px; padding: 0 20px; border: 0; border-radius: var(--r-pill); background: transparent;
    font-weight: 600; font-size: .875rem; color: var(--tinta);
    transition: background .4s var(--ease), color .4s var(--ease);
  }
  .mod__tab[aria-selected='true'] { background: var(--verde-900); color: var(--hueso); }

  .mod__stage { display: grid; }
  .mod__panel {
    grid-area: 1 / 1; display: flex; flex-wrap: wrap; gap: clamp(2.5rem, 5vw, 4rem); align-items: stretch;
    visibility: hidden;
  }
  .mod__panel.is-activo { visibility: visible; }
  .mod__texto { flex: 1 1 440px; min-width: 0; display: flex; flex-direction: column; justify-content: space-between; gap: 40px; }
  .mod__texto > div:first-child > * { opacity: 0; transform: translateY(24px); transition: opacity .7s var(--ease), transform .7s var(--ease); }
  .mod__panel.is-activo .mod__texto > div:first-child > * { opacity: 1; transform: none; }
  .mod__panel.is-activo .mod__nombre { transition-delay: .06s; }
  .mod__panel.is-activo .mod__desc { transition-delay: .12s; }
  .mod__datos, .mod__ctas { opacity: 0; transition: opacity .7s var(--ease) .1s; }
  .mod__panel.is-activo .mod__datos, .mod__panel.is-activo .mod__ctas { opacity: 1; }

  .mod__num { display: flex; align-items: baseline; gap: 14px; font-size: .8125rem; letter-spacing: .3em; font-weight: 700; color: var(--pda-verde); text-transform: uppercase; }
  .mod__num span:first-child { color: #8A8174; letter-spacing: .1em; }
  .mod__tipo { margin-left: 6px; }
  .mod__nombre { margin-top: 18px; font-family: var(--font-display); font-weight: 400; font-size: clamp(5.5rem, 10vw, 10.5rem); line-height: .9; letter-spacing: -.03em; color: var(--verde-900); }
  .mod__nombre em { display: block; font-size: .5em; letter-spacing: -.01em; color: var(--pda-tierra); }
  .mod__desc { margin-top: 28px; max-width: 28.75rem; font-size: 1.125rem; line-height: 1.6; color: var(--tinta-2); }

  .mod__datos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--linea); border-radius: 22px; overflow: hidden; }
  /* dt y dd quedan como hijos directos del div (estructura válida de <dl>); el icono flota a la izquierda */
  .mod__datos > div { position: relative; display: flex; flex-direction: column; justify-content: center; gap: 2px; min-height: 80px; padding: 18px 20px 18px 78px; background: var(--hueso); }
  .mod__datos dt { font-size: .75rem; font-weight: 600; color: var(--gris-texto); }
  .mod__datos dt .ico-box { position: absolute; left: 20px; top: 50%; transform: translateY(-50%); }
  .mod__datos dd { font-size: 1.0625rem; font-weight: 700; }
  .mod__ctas { display: flex; gap: 12px; flex-wrap: wrap; }

  .mod__fotos { flex: 1.25 1 520px; min-width: 0; position: relative; min-height: 640px; }
  .mod__foto-main {
    position: absolute; inset: 0 0 60px 60px; border-radius: var(--r-foto); overflow: hidden;
    clip-path: inset(100% 0 0 0 round var(--r-foto)); transition: clip-path 1.1s var(--ease);
  }
  .mod__foto-main :global(img) { transform: scale(1.12); transition: transform 1.4s var(--ease); }
  .mod__panel.is-activo .mod__foto-main { clip-path: inset(0 round var(--r-foto)); }
  .mod__panel.is-activo .mod__foto-main :global(img) { transform: scale(1); }
  .mod__panel.is-activo .mod__foto-main:hover :global(img) { transform: scale(1.05); }
  .mod__foto-sec {
    position: absolute; left: 0; bottom: 0; width: 42%; aspect-ratio: 4 / 3; border-radius: var(--r-card); overflow: hidden;
    border: 8px solid var(--arena); opacity: 0; transform: translateY(40px); transition: opacity .8s var(--ease) .25s, transform .8s var(--ease) .25s;
  }
  .mod__panel.is-activo .mod__foto-sec { opacity: 1; transform: none; }
  .mod__tag { position: absolute; right: 24px; bottom: 84px; padding: 10px 16px; border-radius: var(--r-pill); background: rgb(250 247 241 / .94); font-size: .8125rem; font-weight: 700; }

  .mod__progreso { display: none; }

  @media (min-width: 1024px) {
    /* La sección se pinnea: tiene que entrar completa en la pantalla */
    .mod { padding-block: clamp(6.5rem, 13vh, 8.75rem) clamp(2rem, 6vh, 4rem); }
    .mod .sec-head { margin-bottom: clamp(1.5rem, 4vh, 4rem); }
    .mod__fotos { min-height: clamp(420px, calc(100svh - 400px), 640px); }
    .mod__nombre { font-size: clamp(4.5rem, min(10vw, 15vh), 10.5rem); }
    .mod__progreso { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; max-width: 360px; position: absolute; left: var(--gutter); bottom: clamp(1rem, 3vh, 2rem); width: 100%; }
    .mod__progreso > span { height: 2px; background: var(--linea); overflow: hidden; }
    .mod__progreso > span > span { display: block; height: 100%; background: var(--pda-verde); transform: scaleX(0); transform-origin: left; }
  }
  /* Pantallas de laptop bajas: todo entra sin cortar los botones */
  @media (min-width: 1024px) and (max-height: 980px) {
    .mod__texto { gap: 22px; }
    .mod__desc { margin-top: 14px; font-size: 1rem; }
    .mod__nombre { margin-top: 10px; }
    .mod__datos > div { min-height: 66px; padding: 12px 16px 12px 68px; }
    .mod__datos dt .ico-box { left: 16px; width: 38px; height: 38px; }
  }

  /* Celular: carrusel con swipe, sin pin */
  @media (max-width: 1023px) {
    .mod__tabs { display: none; }
    .mod__stage {
      display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory;
      margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); scrollbar-width: none;
    }
    .mod__panel {
      flex: none; width: min(86vw, 420px); scroll-snap-align: start; visibility: visible;
      flex-direction: column-reverse; flex-wrap: nowrap; gap: 0; background: var(--hueso); border-radius: 26px; overflow: hidden;
    }
    .mod__texto { flex: 1; padding: 22px 20px 24px; gap: 20px; }
    .mod__texto > div:first-child > *, .mod__datos, .mod__ctas { opacity: 1; transform: none; }
    .mod__num { gap: 10px; font-size: .75rem; letter-spacing: .18em; }
    .mod__num span:first-child { display: none; }
    .mod__tipo { margin-left: 0; }
    .mod__nombre { font-size: 3rem; margin-top: 10px; }
    .mod__desc { margin-top: 12px; font-size: 1rem; }
    .mod__datos > div { min-height: 64px; padding: 12px 12px 12px 58px; }
    .mod__datos dt .ico-box { left: 12px; width: 36px; height: 36px; }
    .mod__ctas .btn { flex: 1; --btn-h: 48px; padding: 0 14px; font-size: .875rem; }
    .mod__fotos { flex: none; min-height: 0; height: 300px; }
    .mod__foto-main { inset: 0; border-radius: 0; clip-path: none; }
    .mod__foto-main :global(img) { transform: none; }
    .mod__foto-sec, .mod__tag { display: none; }
  }
</style>
