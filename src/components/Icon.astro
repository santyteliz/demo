export type IconName = keyof typeof paths;
interface Props { name: IconName; size?: number; class?: string; label?: string; [key: `data-${string}`]: unknown; }
// rest lleva el atributo de estilos con alcance del componente padre
const { name, size = 22, class: cls = '', label, ...rest } = Astro.props;
const fill = name === 'play';
---
<svg
  class:list={['ico', cls]}
  width={size} height={size} viewBox="0 0 24 24"
  style={fill ? 'fill: currentColor; stroke: none' : undefined}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  {...rest}
><path d={paths[name]} /></svg>
