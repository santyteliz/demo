# Copiá este archivo como .env y completá los valores.

# Dominio final (canonical, Open Graph, sitemap)
SITE_URL=https://praderasdearraijan.com

# Endpoint que recibe los leads (webhook de Zoho CRM o Zoho Flow).
# Si queda vacío, el formulario simula el envío y muestra el mensaje de éxito.
PUBLIC_LEADS_WEBHOOK=

# Google Analytics 4 (ej.: G-XXXXXXXXXX). Vacío = sin analítica.
PUBLIC_GA_ID=

# Proveedor de agenda: form (por defecto), zoho-bookings o calendly
PUBLIC_BOOKING_PROVIDER=form
# URL del servicio de agenda cuando el proveedor no es "form"
PUBLIC_BOOKING_URL=
